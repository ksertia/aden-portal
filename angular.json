{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "1e1de97b-a744-405a-8b5a-0397bb3d01ce"
  },
  "newProjectRoot": "projects",
  "projects": {
    "aden-portal": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "namedChunks": true,
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environment/environment.ts",
                  "with": "src/environment/environment.ts"
                }
              ]
            },
            "fr": {
              "aot": true,
              "outputPath": "dist/aden-portal/fr",
              "i18nMissingTranslation": "warning"
            },
            "en": {
              "aot": true,
              "outputPath": "dist/aden-portal/en",
              "i18nMissingTranslation": "warning"
            },
            "fr": {
              "aot": true,
              "outputPath": "dist/aden-portal/fr",
              "i18nFile": "src/locale/messages.fr.xlf",
              "i18nFormat": "xlf",
              "i18nLocale": "fr"
            },
            "en": {
              "aot": true,
              "outputPath": "dist/aden-portal/en",
              "i18nFile": "src/locale/messages.en.xlf",
              "i18nFormat": "xlf",
              "i18nLocale": "en"
            },
            "production": {
              "aot": true,
              "extractLicenses": true,
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "src/environment/environment.ts",
                  "with": "src/environment/environment.prod.ts"
                }
              ]
            }
          },
          "options": {
            "assets": [
              "src/assets"
            ],
            "index": "src/index.html",
            "browser": "src/main.ts",
            "outputPath": "dist/aden-portal",
            "polyfills": ["zone.js"],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ],
            "styles": [
              "src/global_styles.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
              
            ],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "0.0.0.0"
          },
          "configurations": {
            "development": {
              "buildTarget": "aden-portal:build:development"
            },
            "fr": {
              "buildTarget": "aden-portal:build:fr"
            },
            "en": {
              "buildTarget": "aden-portal:build:en"
            },
            "fr": {
              "buildTarget": "demo:build:fr"
            }, 
            "en": {
              "buildTarget": "aden-portal:build:en"
            },
            "production": {
              "buildTarget": "aden-portal:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "prefix": "app",
      "projectType": "application",
      "root": "",
      "schematics": {},
      "sourceRoot": "src"
    }
  },
  "version": 1
}
